# Copiá este archivo a .env.local y completá los valores:
#   cp .env.example .env.local
#
# Ver el README (sección "Puesta en marcha") para el paso a paso de dónde
# sacar cada uno.

# --- Supabase (obligatorias para que la app arranque) ---
# Project Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Precios Claros ---
# API pública del Estado. Este valor por defecto funciona tal cual.
PRECIOS_CLAROS_API_URL=https://d3e6htiiul5ek9.cloudfront.net/prod/productos

# --- Historial de precios y cron diario (opcionales) ---
# Sin estas dos, la app funciona igual pero no se acumula historial de
# precios ni corre el cron de snapshot-prices.
# Project Settings → API → "service_role" (¡nunca la expongas al navegador!)
SUPABASE_SERVICE_ROLE_KEY=
# String random largo, el mismo que configures en vercel.json / el cron.
CRON_SECRET=

# --- Panel /admin (opcional) ---
# Emails con acceso a /admin, separados por coma. Sin esto, /admin queda
# cerrado para todos.
ADMIN_EMAILS=

# --- Push real (avisos con la app cerrada, opcional) ---
# Generar con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY y VAPID_PUBLIC_KEY son la MISMA clave
# pública, una vez con el prefijo NEXT_PUBLIC_ (llega al navegador) y otra
# sin él (solo servidor).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- Premium por WhatsApp (opcional) ---
# Número al que se abre WhatsApp desde el modal de "Quiero Premium".
NEXT_PUBLIC_PREMIUM_WHATSAPP=

# --- Sitio (opcional) ---
# URL pública del sitio, usada en metadata (og:image, sitemap, etc.). En
# Vercel se completa sola con VERCEL_PROJECT_PRODUCTION_URL si la dejás vacía.
NEXT_PUBLIC_SITE_URL=
