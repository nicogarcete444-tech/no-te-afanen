# URL canónica pública del sitio, sin barra final. La usan /sitemap.xml,
# /robots.txt y metadataBase (og:image, canonical).
# En Vercel se puede omitir: se deduce sola de VERCEL_PROJECT_PRODUCTION_URL.
# Definila cuando enchufes un dominio propio, p. ej. https://notoafanen.com.ar
NEXT_PUBLIC_SITE_URL=https://no-te-afanen.vercel.app

# Supabase: Project Settings → API en tu proyecto de supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL de la API pública de Precios Claros que consume el proxy del servidor
PRECIOS_CLAROS_API_URL=https://d3e6htiiul5ek9.cloudfront.net/prod/productos

# --- Historial de precios (solo necesarias si usás el cron de snapshots) ---

# Service role key de Supabase (Project Settings → API → "service_role").
# OJO: esta key ignora Row Level Security. Nunca la pongas en una variable
# NEXT_PUBLIC_* ni la mandes al navegador — solo la usa el cron y el
# dashboard de /admin, en el server.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# String random (32+ caracteres) que vos elegís. Configurala también en
# Vercel → Settings → Environment Variables. Vercel manda este mismo valor
# como header "Authorization: Bearer ..." cada vez que dispara el cron, así
# que /api/cron/snapshot-prices lo puede validar y rechazar pedidos ajenos.
CRON_SECRET=elegi-un-string-random-largo

# --- Push real (avisos al celular aunque la app esté cerrada) ---
#
# Generá el par de claves UNA sola vez con:
#   npx web-push generate-vapid-keys
# Son las mismas para siempre (no se regeneran en cada deploy). Guardalas
# en Vercel → Environment Variables, igual que las de arriba.

# Pública: va al navegador (por eso el prefijo NEXT_PUBLIC_), no es secreta.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
# La misma clave pública, pero disponible también del lado del server
# (lib/webPush.ts corre en el server y no lee variables NEXT_PUBLIC_ de
# forma especial, así que se repite acá sin el prefijo).
VAPID_PUBLIC_KEY=tu-vapid-public-key
# Privada: NUNCA con prefijo NEXT_PUBLIC_, solo la usa el server para firmar
# los envíos.
VAPID_PRIVATE_KEY=tu-vapid-private-key
# Un mailto de contacto (lo pide el estándar Web Push, lo ven los servicios
# de push -Google/Mozilla/Apple- si algo sale mal, no el usuario final).
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- Premium ---
#
# El alta es manual y se coordina por WhatsApp: no hay pasarela de pago
# cableada, así que no hace falta ninguna credencial de Mercado Pago ni de
# ningún otro procesador (la integración vieja con Mercado Pago se dio de
# baja junto con sus rutas de API).
#
# Número al que llegan los pedidos de alta/baja, en formato wa.me: código de
# país + código de área sin 0 ni 15 + número, todo junto y sin símbolos.
# Si no la definís, se usa el número que está por defecto en
# lib/premiumPricing.ts.
NEXT_PUBLIC_PREMIUM_WHATSAPP=5491100000000

# El precio mensual NO se configura por variable de entorno — está en
# lib/premiumPricing.ts (PREMIUM_MONTHLY_PRICE_ARS) para que el precio que se
# muestra y el que le decís al usuario por WhatsApp salgan del mismo lugar.

# --- Dashboard de admin (/admin) ---
#
# Emails que pueden entrar a /admin, separados por coma si son varios. Con
# solo estar logueado con una cuenta de esta lista alcanza (no hace falta
# nada más). Necesita también SUPABASE_SERVICE_ROLE_KEY (ya definida arriba)
# para poder leer los datos de TODOS los usuarios.
ADMIN_EMAILS=tu-email@ejemplo.com
