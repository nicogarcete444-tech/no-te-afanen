# Supabase: necesarias para iniciar sesión y guardar datos.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Supabase service_role: necesaria para funciones administrativas, el historial
# de precios y el límite compartido de solicitudes. Nunca usar como NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URLs de la app y de las fuentes de precios.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PRECIOS_CLAROS_API_URL=https://d3e6htiiul5ek9.cloudfront.net/prod/productos

# Administración y contacto para Premium (opcionales).
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_PREMIUM_WHATSAPP=549XXXXXXXXXX

# Cron diario de snapshots (configurar en producción).
CRON_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# Web Push: generar con `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid
VAPID_SUBJECT=mailto:admin@example.com
